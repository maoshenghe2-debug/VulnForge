{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/maoshenghe2-debug/VulnForge/schemas/crash_report.schema.json",
  "title": "VulnForge 崩溃报告",
  "type": "object",
  "required": ["schema_version", "tool", "tool_version", "generated_at", "target", "fuzzing", "findings", "disclaimer"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": { "type": "string" },
    "tool_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "job_id": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["source", "environment"],
      "properties": {
        "source": { "type": "string" },
        "binary_sha256": { "type": "string" },
        "compiler": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "string" }
      }
    },
    "fuzzing": {
      "type": "object",
      "required": ["cores", "duration_s", "execs_total", "crashes_total"],
      "properties": {
        "cores": { "type": "integer", "minimum": 1 },
        "duration_s": { "type": "integer", "minimum": 1 },
        "execs_total": { "type": "integer", "minimum": 0 },
        "crashes_total": { "type": "integer", "minimum": 0 },
        "unique_defects": { "type": "integer", "minimum": 0 }
      }
    },
    "static_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "title", "cwe"],
        "properties": {
          "rule_id": { "type": "string" },
          "title": { "type": "string" },
          "cwe": { "type": "string" },
          "severity": { "type": "string" },
          "line": { "type": "integer" },
          "advice": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "signal", "signal_name", "severity", "cwe_suggestion", "dedup_key", "frames", "summary", "impact", "reproduce", "evidence", "remediation"],
        "properties": {
          "id": { "type": "string", "pattern": "^VF-[0-9A-F]{8}$" },
          "title": { "type": "string" },
          "signal": { "type": "integer" },
          "signal_name": { "type": "string" },
          "severity": { "enum": ["high", "medium", "low"] },
          "cwe_suggestion": { "type": "string" },
          "dedup_key": { "type": "string" },
          "frames": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "impact": { "type": "string" },
          "reproduce": {
            "type": "object",
            "required": ["repro_script", "input_sha256", "input_size", "exit_contract", "steps"],
            "properties": {
              "repro_script": { "type": "string" },
              "input": { "type": "string" },
              "input_sha256": { "type": "string" },
              "input_size": { "type": "integer", "minimum": 0 },
              "exit_contract": { "type": "string" },
              "steps": { "type": "array", "items": { "type": "string" } }
            }
          },
          "evidence": {
            "type": "object",
            "required": ["crash_count", "crashes"],
            "properties": {
              "crash_count": { "type": "integer", "minimum": 1 },
              "crashes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["file", "sha256", "signal"],
                  "properties": {
                    "file": { "type": "string" },
                    "sha256": { "type": "string" },
                    "signal": { "type": "integer" }
                  }
                }
              },
              "fault_addr": { "type": "string" },
              "minimized": { "type": "boolean" }
            }
          },
          "remediation": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disclaimer": { "type": "string" }
  }
}
